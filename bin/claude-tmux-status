#!/usr/bin/env bash
# Claude Code statusLine command.
#
# Prints Claude's in-app status line and records account-wide quota usage to a
# shared state file. The numbers (5h session + weekly limits) are per-account, not
# per-session, so any running session is an equally good reporter -- which is what
# lets the tmux widget be session-agnostic. Nothing here touches tmux or needs to
# know which pane, or even which terminal, Claude is running in.
#
# State: ~/.cache/claude-tmux/quota[-<account>] -- "<5h used> <5h resets> <wk used> <wk resets> <written>"
#        5h used is -1 (resets 0) for an account without a 5h window: since
#        2026-10-30, verified Ultra accounts have only the weekly limit.
# Pane:  ~/.cache/claude-tmux/panes/<n> -- "<account> <claude pid>", for the pane %<n>
# Session: ~/.cache/claude-tmux/sessions/<session id> -- "<account> <claude pid>"
# Consumer: ~/.local/bin/tmux-claude-widget

set -uo pipefail

STATE_DIR=~/.cache/claude-tmux
STATE=$STATE_DIR/quota

# Quotas are per-account, so each account (one CLAUDE_CONFIG_DIR each) reports to
# its own file instead of clobbering another's reading. ~/.claude-<name> is <name>.
cfg=${CLAUDE_CONFIG_DIR:-}
cfg=${cfg%/}
if [[ -z $cfg || $cfg == "$HOME/.claude" ]]; then
  account=personal
elif [[ $cfg == "$HOME/.claude-"* ]]; then
  account=${cfg#"$HOME/.claude-"}
else
  account=${cfg##*/}; account=${account#.}; account=${account#claude-}
fi
# The name ends up in a file name and a tmux option name.
account=${account//[^A-Za-z0-9_-]/-}
[ -n "$account" ] || account=personal
[ "$account" = personal ] || STATE=$STATE_DIR/quota-$account

# Nearest ancestor named claude: the session this status line belongs to. npm
# installs run as node, so fall back to the parent rather than guess further.
claude_pid() {
  local pid=$PPID ppid comm i
  for ((i = 0; i < 8 && pid > 1; i++)); do
    read -r ppid comm < <(ps -o ppid=,comm= -p "$pid" 2>/dev/null) || break
    [ "${comm##*/}" = claude ] && { echo "$pid"; return; }
    pid=$ppid
  done
  echo "$PPID"
}

# Tell the widget which account this pane, or this session, runs, so it can follow
# the focused pane. Entries live as long as the claude process; dead ones are swept
# on every run.
PANES=$STATE_DIR/panes SESSIONS=$STATE_DIR/sessions
for f in "$PANES"/* "$SESSIONS"/*; do
  [[ -f $f && $f != *.tmp ]] || continue
  pid=; read -r _ pid 2>/dev/null < "$f"
  # Guarded: `kill -0 0` would probe our own process group and always succeed.
  [[ $pid =~ ^[1-9][0-9]*$ ]] && kill -0 "$pid" 2>/dev/null || rm -f "$f"
done
# Write-then-rename so a half-written line is never read by the widget.
attribute() {
  mkdir -p "${1%/*}" 2>/dev/null
  printf '%s %s\n' "$account" "$owner" > "$1.tmp" 2>/dev/null && mv -f "$1.tmp" "$1" 2>/dev/null
}
owner=$(claude_pid)
[[ ${TMUX_PANE:-} =~ ^%([0-9]+)$ ]] && attribute "$PANES/${BASH_REMATCH[1]}"

payload=$(cat)

# Tab-separated so directories with spaces survive the read.
IFS=$'\t' read -r model dir pct used win cents used5 resets5 used7 resets7 session < <(
  printf '%s' "$payload" | jq -r '
    [ .model.display_name // "claude",
      (.workspace.current_dir // .cwd // ""),
      ((.context_window.used_percentage // 0) | round),
      ((.context_window.total_input_tokens // 0) + (.context_window.total_output_tokens // 0)),
      (.context_window.context_window_size // 0),
      (((.cost.total_cost_usd // 0) * 100) | round),
      (.rate_limits.five_hour.used_percentage // -1 | floor),
      (.rate_limits.five_hour.resets_at // 0),
      (.rate_limits.seven_day.used_percentage // -1 | floor),
      (.rate_limits.seven_day.resets_at // 0),
      (.session_id // "" | tostring | gsub("[^A-Za-z0-9_-]"; "-"))
    ] | @tsv'
)

# A background session's status line runs outside any pane; the widget matches
# the pane's `claude attach <id>` against this instead. Last field, so an absent
# id cannot shift the others.
[ -n "${session:-}" ] && attribute "$SESSIONS/$session"

# Only publish when the payload actually carried subscription limits (API-key auth
# has none); the last good reading is better than a file full of -1s. The weekly
# window is the one every plan has; the 5h one is optional (verified Ultra accounts
# don't have it), and is recorded as -1 so the widget hides its badge.
if ((used7 >= 0)); then
  ((used5 >= 0)) || { used5=-1; resets5=0; }
  mkdir -p "$STATE_DIR" 2>/dev/null
  # Write-then-rename so a half-written line is never read by the widget.
  printf '%s %s %s %s %s\n' "$used5" "$resets5" "$used7" "$resets7" "$(date +%s)" \
    > "$STATE.tmp" 2>/dev/null && mv -f "$STATE.tmp" "$STATE" 2>/dev/null
fi

# 58436 -> 58k, 1240000 -> 1.2M
human() {
  local n=${1:-0}
  if   ((n >= 1000000)); then printf '%d.%dM' $((n / 1000000)) $((n % 1000000 / 100000))
  elif ((n >= 1000));    then printf '%dk' $((n / 1000))
  else printf '%d' "$n"
  fi
}

printf ' [%s] %s · %s · %s%% (%s/%s) · $%d.%02d\n' \
  "$account" "$model" "${dir/#$HOME/\~}" "$pct" "$(human "${used:-0}")" "$(human "${win:-0}")" \
  $((cents / 100)) $((cents % 100))
